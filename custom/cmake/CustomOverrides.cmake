set(QGC_BRAND "futurewings" CACHE STRING "Brand to build: futurewings, nicewing, antg")
set_property(CACHE QGC_BRAND PROPERTY STRINGS futurewings nicewing antg)

if(QGC_BRAND STREQUAL "futurewings")
    set(QGC_BRAND_APP_NAME "FutureWings")
    set(QGC_BRAND_PACKAGE_SUFFIX "futurewings")
    set(QGC_BRAND_GRADIENT_COLOR "#06439a")
elseif(QGC_BRAND STREQUAL "nicewing")
    set(QGC_BRAND_APP_NAME "NiceWing")
    set(QGC_BRAND_PACKAGE_SUFFIX "nicewing")
    set(QGC_BRAND_GRADIENT_COLOR "#03085f")
elseif(QGC_BRAND STREQUAL "antg")
    set(QGC_BRAND_APP_NAME "ANTG")
    set(QGC_BRAND_PACKAGE_SUFFIX "antg")
    set(QGC_BRAND_GRADIENT_COLOR "#5f1818")
else()
    message(FATAL_ERROR "Unsupported QGC_BRAND '${QGC_BRAND}'. Use one of: futurewings, nicewing, antg.")
endif()

set(QGC_APP_NAME "${QGC_BRAND_APP_NAME}" CACHE STRING "App Name" FORCE)
set(QGC_APP_DESCRIPTION "${QGC_BRAND_APP_NAME} Ground Control App" CACHE STRING "Description" FORCE)
set(QGC_ORG_NAME "${QGC_BRAND_APP_NAME}" CACHE STRING "Org Name" FORCE)
set(QGC_ORG_DOMAIN "futurewings.local" CACHE STRING "Domain" FORCE)
set(QGC_PACKAGE_NAME "com.futurewings.${QGC_BRAND_PACKAGE_SUFFIX}" CACHE STRING "Package Name" FORCE)
set(QGC_ANDROID_PACKAGE_NAME "${QGC_PACKAGE_NAME}" CACHE STRING "Android Package Name" FORCE)
set(QGC_STABLE_BUILD ON CACHE BOOL "Stable Build" FORCE)

set(QGC_WINDOWS_ICON_PATH "${CMAKE_SOURCE_DIR}/custom/deploy/windows/${QGC_BRAND}/WindowsQGC.ico" CACHE FILEPATH "Windows Icon Path" FORCE)
set(QGC_WINDOWS_INSTALL_HEADER_PATH "${CMAKE_SOURCE_DIR}/custom/deploy/windows/${QGC_BRAND}/installheader.bmp" CACHE FILEPATH "Windows Install Header Path" FORCE)
set(QGC_APPIMAGE_ICON_PATH "${CMAKE_SOURCE_DIR}/custom/res/brand/${QGC_BRAND}/logo.png" CACHE FILEPATH "AppImage Icon Path" FORCE)
